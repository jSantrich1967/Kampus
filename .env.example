# Kampus environment template
#
# Local: copy this file to `.env.local` and fill in values (`.env.local` is gitignored).
# Production (Vercel): add the same variable names in Project → Settings → Environment Variables, then redeploy.
# Never commit real keys to Git — only this template.

# --- Optional: local dev on Windows (paths with spaces, AV locks, Turbopack). Leave unset on Linux/macOS/CI. ---
# Custom dev output dir (development only). Production/Vercel always uses `.next`.
# KAMPUS_NEXT_DIST_DIR=.next-kampus
# If `next dev` fails with `.next/dev/lock` (ENOENT), try:
# KAMPUS_NEXT_DISABLE_DIST_LOCK=true
# Optional: override Turbopack root (relative to this project). Default is this project directory.
# KAMPUS_TURBOPACK_ROOT=.

# Supabase (Auth + Postgres). Create a project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to false to browse without login while keys exist (local / Vercel Preview only). Default: protection ON when URL+anon key are set.
# Vercel Production: do NOT set false — `next build` fails, and middleware always protects routes when Supabase is configured.
# NEXT_PUBLIC_REQUIRE_AUTH=false
# When bypass is active, show the Settings warning in non-dev builds if you set:
# NEXT_PUBLIC_SHOW_AUTH_BYPASS_WARNING=true
# After-login ?next= redirect: in production, only first-party app paths are allowed. Set to false to relax (previews / local).
# NEXT_PUBLIC_REDIRECT_STRICT=false
# In Supabase: Authentication > URL configuration — add redirect http://localhost:3002/auth/callback (and your production URL).

# Sentry (optional). Create a Next.js project at https://sentry.io — copy the DSN.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Performance tracing sample rate 0–1 (server + edge). Default: 1 in dev, 0.05 in production.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Browser tracing (optional; must be NEXT_PUBLIC_ to apply on the client).
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Temporary: show a “Probar Sentry” button in Settings (turn OFF after verification).
# NEXT_PUBLIC_ENABLE_SENTRY_TEST=true
# Optional: source maps on Vercel build (Settings → Auth Tokens → token with project:releases scope)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# API rate limits (per server instance, by client IP). OpenAI-backed routes; tune in production if needed.
# API_RL_MAX_PSYCHOLOGIST_CHAT=40
# API_RL_WINDOW_MS=900000
# API_RL_MAX_RESCUE_PACK=20
# API_RL_RESCUE_PACK_WINDOW_MS=3600000
# API_RL_MAX_RESCUE_EXTRACT=45
# API_RL_RESCUE_EXTRACT_WINDOW_MS=3600000
# API_RL_MAX_PRESENTATION_TUTOR=35
# API_RL_MAX_TRANSCRIBE=30
# API_RL_TRANSCRIBE_WINDOW_MS=3600000
#
# Per-user daily quotas (requires migration 20260505170000_api_usage_quotas.sql in Supabase).
# Defaults below if unset. Raise limits for local dev or small teams (e.g. kit de estudio).
# API_DAILY_LIMIT_PSYCHOLOGIST_CHAT=10
# API_DAILY_LIMIT_RESCUE_PACK=20
# API_DAILY_LIMIT_RESCUE_EXTRACT=20
# API_DAILY_LIMIT_PRESENTATION_TUTOR=6
# API_DAILY_LIMIT_EXAM_CORRECTOR=10
# API_DAILY_LIMIT_PRESENTATION_TRANSCRIBE=1
# API_DAILY_LIMIT_STUDY_ROOM_ASSISTANT=15
# API_DAILY_LIMIT_VIRTUAL_CLASS_TRANSCRIBE=3

# Tutor IA (OpenAI) — required for kit de estudio, OCR, tutor, bienestar chat, etc.
# Without OPENAI_API_KEY the app shows a basic fallback kit instead of full AI output.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Transcripcion de audio (Aula Virtual)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# OCR de imagenes (foto a texto) y PDFs escaneados (vision)
OPENAI_VISION_MODEL=gpt-4.1-mini
# Paginas maximas por PDF al usar OCR de OpenAI (default 5)
PDF_OCR_MAX_PAGES=5
# Worker de pdf-parse en serverless. Default: ruta local o data: URL embebida (pdf-parse/worker).
# PDF_PARSE_WORKER_URL=

# Gutenberg via RapidAPI (opcional, si tienes key)
GUTENBERG_RAPIDAPI_KEY=
GUTENBERG_RAPIDAPI_HOST=

# Landing — correo mostrado en formulario de ventas institucionales (opcional).
# NEXT_PUBLIC_KAMPUS_SALES_EMAIL=ventas@kampus.app
# Notificaciones de leads por correo (opcional). Sin RESEND_API_KEY el formulario
# solo valida y responde; con la key, cada lead llega por correo a la dirección
# de arriba. Crea la key en https://resend.com/api-keys
# RESEND_API_KEY=re_xxx
# Remitente verificado en Resend (onboarding@resend.dev sirve solo para pruebas).
# RESEND_FROM_EMAIL=Kampus <ventas@kampus.app>

# Bienestar Iter 7 — Web Push (recordatorio 18:00 desde servidor)
# Generar claves: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:wellbeing@kampus.app
# SUPABASE_SERVICE_ROLE_KEY=  # solo servidor — cron push y limpieza de suscripciones
# CRON_SECRET=  # Authorization: Bearer <CRON_SECRET> en POST /api/wellbeing/push/cron-check-in
# Colaboración Iter 8 — feed webcal usa SUPABASE_SERVICE_ROLE_KEY en GET /api/collaborate/calendar/webcal/[token]
# NEXT_PUBLIC_APP_URL=https://tu-dominio.com  # URLs en .ics y webcal
# WELLBEING_COUNSELOR_SIGNING_SECRET=  # openssl rand -hex 32 — firma HMAC del resumen orientador
# WELLBEING_INSTITUTION_WEBHOOK_URL=  # POST JSON on opt-in counselor alerts (Iter 8)
# WELLBEING_INSTITUTION_WEBHOOK_SECRET=  # optional Bearer token for webhook
