# Supabase (Auth + Postgres). Create a project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to false to keep the app browsable without login while keys exist (preview / demo). Default: protection on when URL+anon key are set.
# NEXT_PUBLIC_REQUIRE_AUTH=false
# In production-like builds, show the Settings warning when REQUIRE_AUTH is false (optional; dev shows it automatically).
# NEXT_PUBLIC_SHOW_AUTH_BYPASS_WARNING=true
# In Supabase: Authentication > URL configuration — add redirect http://localhost:3002/auth/callback (and your production URL).

# Tutor IA (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Transcripcion de audio (Aula Virtual)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# OCR de imagenes (foto a texto)
OPENAI_VISION_MODEL=gpt-4.1-mini

# Gutenberg via RapidAPI (opcional, si tienes key)
GUTENBERG_RAPIDAPI_KEY=
GUTENBERG_RAPIDAPI_HOST=
